---
// Header component
---

<div class="navigation-wrap bg-white start-header start-style">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <nav class="navbar navbar-light navbar-expand-md">
          <a class="navbar-brand" href="/">
            <img src="/logo.png" alt="amirdaraee" />
          </a>
          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse cl-effect-1" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto py-4 py-md-0">
              <li class="nav-item">
                <a class="nav-link" href="/blog">Blog</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/portfolio">Portfolio</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/about">About</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/uses">Uses</a>
              </li>
            </ul>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>

<style>
  .nav-link {
    @apply relative inline-block px-4 py-2 text-gray-900 font-medium uppercase tracking-wide no-underline transition-colors duration-200;
  }

  .nav-link:hover {
    @apply text-gray-600;
  }

  /* Bracket hover effect */
  .nav-links .nav-link::before,
  .nav-links .nav-link::after {
    display: inline-block;
    opacity: 0;
    transition: transform 0.3s, opacity 0.2s;
  }

  .nav-links .nav-link::before {
    content: '[';
    margin-right: 10px;
    transform: translateX(20px);
  }

  .nav-links .nav-link::after {
    content: ']';
    margin-left: 10px;
    transform: translateX(-20px);
  }

.cl-effect-1 a:hover::before,
.cl-effect-1 a:hover::after,
.cl-effect-1 a:focus::before,
.cl-effect-1 a:focus::after {
  opacity: 1;
  -webkit-transform: translateX(0px);
  -moz-transform: translateX(0px);
  transform: translateX(0px);
}

/* Mobile styles */
@media (max-width: 767px) {
  .navbar-nav {
    text-align: center;
  }
  .nav-item {
    padding: 0.5rem 0;
  }
  .navbar-toggler {
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 0.5rem 0.75rem;
  }
  .navbar-toggler:focus {
    box-shadow: none;
  }
  /* Disable bracket effect on mobile for cleaner look */
  .cl-effect-1 a::before,
  .cl-effect-1 a::after {
    display: none;
  }
}
</style>
