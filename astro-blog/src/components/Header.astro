---
// Header component
---

<header class="bg-white w-full z-50 py-2.5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between">
      <a href="/" class="flex-shrink-0">
        <img src="/logo.png" alt="amirdaraee" class="h-13 w-auto" />
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-gray-500"
        id="mobile-menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Hamburger icon -->
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="menu-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon (hidden by default) -->
        <svg class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="close-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Desktop menu -->
      <div class="hidden md:flex md:items-center md:space-x-1 nav-links">
        <a href="/blog" class="nav-link">Blog</a>
        <a href="/portfolio" class="nav-link">Portfolio</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/uses" class="nav-link">Uses</a>
      </div>
    </nav>

    <!-- Mobile menu (hidden by default) -->
    <div class="hidden md:hidden" id="mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-1 text-center">
        <a href="/blog" class="block px-3 py-2 text-gray-900 hover:text-gray-600 font-medium uppercase tracking-wide">Blog</a>
        <a href="/portfolio" class="block px-3 py-2 text-gray-900 hover:text-gray-600 font-medium uppercase tracking-wide">Portfolio</a>
        <a href="/about" class="block px-3 py-2 text-gray-900 hover:text-gray-600 font-medium uppercase tracking-wide">About</a>
        <a href="/uses" class="block px-3 py-2 text-gray-900 hover:text-gray-600 font-medium uppercase tracking-wide">Uses</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>

<style>
  .nav-link {
    @apply relative inline-block px-4 py-2 text-gray-900 font-medium uppercase tracking-wide no-underline transition-colors duration-200;
  }

  .nav-link:hover {
    @apply text-gray-600;
  }

  /* Bracket hover effect */
  .nav-links .nav-link::before,
  .nav-links .nav-link::after {
    display: inline-block;
    opacity: 0;
    transition: transform 0.3s, opacity 0.2s;
  }

  .nav-links .nav-link::before {
    content: '[';
    margin-right: 10px;
    transform: translateX(20px);
  }

  .nav-links .nav-link::after {
    content: ']';
    margin-left: 10px;
    transform: translateX(-20px);
  }

  .nav-links .nav-link:hover::before,
  .nav-links .nav-link:hover::after,
  .nav-links .nav-link:focus::before,
  .nav-links .nav-link:focus::after {
    opacity: 1;
    transform: translateX(0px);
  }
</style>
