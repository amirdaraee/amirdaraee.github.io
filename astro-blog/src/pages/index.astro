---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Amirdaraee - Full-Stack Web Developer" showCopyright={false}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center min-h-[calc(100vh-12rem)]">
    <main role="main" class="text-center py-8">
      <h1 class="mb-6">
        <img
          class="rounded-full mx-auto w-64 sm:w-72 md:w-80"
          src="/Amirhossein-Daraee-GIF.gif"
          alt="Amirdaraee"
        />
      </h1>
      <p class="text-base md:text-lg text-gray-700 leading-relaxed mx-auto max-w-2xl px-4">
        Hi, My name is Amirhossein and I'm a Full-Stack web developer from Tehran, Iran and this
        is my spot on the web, where I'm trying to share what I'm learning throughout my
        daily life, I hope you enjoy it.
      </p>
    </main>
  </div>
</Layout>
