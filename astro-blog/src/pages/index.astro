---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Amirdaraee - Full-Stack Web Developer" showCopyright={false} compactFooter={true}>
  <div class="absolute inset-0 flex items-center justify-center">
    <main role="main" class="text-center px-4 sm:px-6 lg:px-8">
      <h1 class="mb-4">
        <img
          class="rounded-full mx-auto w-64 sm:w-64 md:w-96"
          src="/Amirhossein-Daraee.png"
          alt="Amirdaraee"
        />
      </h1>
      <p class="text-base md:text-lg text-gray-700 dark:text-gray-300 leading-relaxed mx-auto max-w-2xl">
        Hi, I'm Amirhossein, a full-stack web developer based in Luxembourg. I specialize in .NET universe and enjoy building clean, scalable, and meaningful software. This is my space on the web where I share what I'm learning, creating, and exploring across technology, AI, and personal growth. I hope you enjoy your visit.
      </p>
    </main>
  </div>
</Layout>
