---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Amirdaraee - Full-Stack Web Developer" showCopyright={false} compactFooter={true}>
  <div class="flex items-center justify-center min-h-full">
    <main role="main" class="text-center px-4 sm:px-6 lg:px-8 py-8">
      <h1 class="mb-4">
        <img
          class="rounded-full mx-auto w-48 sm:w-56 md:w-64"
          src="/Amirhossein-Daraee-GIF.gif"
          alt="Amirdaraee"
        />
      </h1>
      <p class="text-base md:text-lg text-gray-700 leading-relaxed mx-auto max-w-2xl">
        Hi, My name is Amirhossein and I'm a Full-Stack web developer from Tehran, Iran and this
        is my spot on the web, where I'm trying to share what I'm learning throughout my
        daily life, I hope you enjoy it.
      </p>
    </main>
  </div>
</Layout>
