---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Amirdaraee - Full-Stack Web Developer">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <main role="main" class="text-center mt-12">
      <h1 class="mb-8">
        <img
          class="rounded-full mx-auto max-w-md w-full"
          src="/Amirhossein-Daraee-GIF.gif"
          alt="Amirdaraee"
        />
      </h1>
      <p class="text-lg text-gray-700 leading-relaxed my-8 mx-auto max-w-3xl md:px-12">
        Hi, My name is Amirhossein and I'm a Full-Stack web developer from Tehran, Iran and this
        is my spot on the web, where I'm trying to share what I'm learning throughout my
        daily life, I hope you enjoy it.
      </p>
    </main>
  </div>
</Layout>
