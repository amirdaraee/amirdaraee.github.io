---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio - Amirdaraee">
  <div class="container my-5">
    <h2 class="text-center mb-5">Portfolio</h2>

    <div class="row justify-content-around">
      <!--amirdaraee-->
      <div class="card mb-3" style="max-width: 540px;">
        <div class="row no-gutters">
          <div class="col-md-4">
            <a href="https://amirdaraee.com" target="_blank" rel="noopener noreferrer">
              <img
                src="/assets/logo.png"
                class="card-img"
                title="amirdaraee"
                alt="amirdaraee logo app"
              />
            </a>
          </div>
          <div class="col-md-8">
            <div class="card-body bg-light">
              <h5 class="card-title">amirdaraee.com</h5>
              <p class="card-subtitle mb-1">
                A personal blog about software development and programming, to
                document and share the things I learned along the way.
              </p>
              <p class="card-text">
                The blog is developed using Astro, a modern static site generator,
                with Bootstrap for styling.
              </p>
              <p class="card-text">
                <small class="text-muted">Technology used</small>
              </p>
              <span class="badge badge-pill badge-danger">Astro</span>
              <span class="badge badge-pill badge-success">TypeScript</span>
              <span
                class="badge badge-pill"
                style="background-color: #814dce; color: white;"
                >Bootstrap</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
