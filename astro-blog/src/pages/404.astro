---
import SEO from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <SEO
      title="404 - Page Not Found"
      description="The page you're looking for doesn't exist."
      canonical={Astro.url.href}
      type="website"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="msapplication-TileColor" content="#ffffff" />

    <!-- Self-hosted Operator Mono font faces -->
    <link rel="stylesheet" href="/fonts/operator-mono.css" />

    <!-- Dark mode initialization script - prevents flash -->
    <script is:inline>
      // Initialize theme before page renders to prevent flash
      (function() {
        const savedTheme = localStorage.getItem('theme');

        // Default to dark mode unless explicitly set to light
        if (savedTheme !== 'light') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google Analytics -->
    <Analytics contentGroup="404" />
    <script is:inline>
      // Report which URL 404'd and where the visitor came from,
      // so broken inbound/internal links surface in GA.
      window.gtag?.('event', 'page_not_found', {
        page_location: window.location.href,
        referrer: document.referrer || '(direct)',
      });
    </script>

    <title>404 - Page Not Found</title>
  </head>
  <body class="font-sans bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200">
    <main class="min-h-screen flex flex-col items-center justify-center gap-6 px-6 text-center" role="main" aria-label="Page not found">
      <h1
        class="flex items-center justify-center gap-2 text-[8rem] font-bold leading-none text-blue-600 sm:gap-4 sm:text-[14rem] lg:text-[18rem] dark:text-blue-400"
        aria-label="Error 404"
      >
        <span aria-hidden="true">4</span>
        <picture aria-hidden="true">
          <source
            srcset="/Amirhossein-Daraee-404-blink.webp"
            type="image/webp"
            media="(prefers-reduced-motion: no-preference)"
          />
          <img
            src="/Amirhossein-Daraee-404.webp"
            alt=""
            width="800"
            height="800"
            class="block h-[0.9em] w-[0.9em] rounded-full object-cover"
            fetchpriority="high"
          />
        </picture>
        <span aria-hidden="true">4</span>
      </h1>

      <p class="text-lg text-gray-600 sm:text-xl dark:text-gray-400">This page doesn't exist.</p>

      <a
        href="/"
        class="inline-block rounded-lg bg-blue-600 px-6 py-2.5 font-medium text-white transition-colors duration-200 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400"
      >
        ← Take me home
      </a>
    </main>
  </body>
</html>
