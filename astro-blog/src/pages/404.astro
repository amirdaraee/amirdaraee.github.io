---
import SEO from "../components/SEO.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <SEO
      title="404 - Page Not Found"
      description="The page you're looking for doesn't exist."
      canonical={Astro.url.href}
      type="website"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="msapplication-TileColor" content="#ffffff" />

    <!-- Dark mode initialization script - prevents flash -->
    <script is:inline>
      // Initialize theme before page renders to prevent flash
      (function() {
        const savedTheme = localStorage.getItem('theme');

        // Default to dark mode unless explicitly set to light
        if (savedTheme !== 'light') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <title>404 - Page Not Found</title>
  </head>
  <body class="font-sans bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200 overflow-y-scroll">
    <div class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
      <div class="max-w-2xl w-full text-center">
        <!-- 404 Large Display -->
        <h1 class="text-9xl font-bold text-gray-300 dark:text-gray-700 mb-4">
          404
        </h1>

        <!-- Error Message -->
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          Page Not Found
        </h2>

        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
          Sorry, the page you're looking for doesn't exist or has been moved.
        </p>

        <!-- Navigation Options -->
        <div class="space-y-6">
          <!-- Primary CTA -->
          <div>
            <a
              href="/"
              class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-md transition-colors duration-200"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                ></path>
              </svg>
              Back to Home
            </a>
          </div>

          <!-- Helpful Links -->
          <div class="pt-4 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
              Or explore these pages:
            </p>
            <div class="flex flex-wrap justify-center gap-3">
              <a
                href="/blog"
                class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 border border-gray-300 dark:border-gray-600 rounded-md hover:border-blue-600 dark:hover:border-blue-400 transition-colors duration-200"
              >
                Blog
              </a>
              <a
                href="/portfolio"
                class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 border border-gray-300 dark:border-gray-600 rounded-md hover:border-blue-600 dark:hover:border-blue-400 transition-colors duration-200"
              >
                Portfolio
              </a>
              <a
                href="/about"
                class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 border border-gray-300 dark:border-gray-600 rounded-md hover:border-blue-600 dark:hover:border-blue-400 transition-colors duration-200"
              >
                About
              </a>
              <a
                href="/contact"
                class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 border border-gray-300 dark:border-gray-600 rounded-md hover:border-blue-600 dark:hover:border-blue-400 transition-colors duration-200"
              >
                Contact
              </a>
            </div>
          </div>
        </div>

        <!-- Additional Help Text -->
        <div class="mt-12 text-sm text-gray-500 dark:text-gray-500">
          <p>
            If you think this is a mistake, please
            <a href="/contact" class="text-blue-600 dark:text-blue-400 hover:underline">
              let me know
            </a>.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
