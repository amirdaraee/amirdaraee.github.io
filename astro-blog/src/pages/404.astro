---
import { getCollection } from 'astro:content';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import Analytics from "../components/Analytics.astro";
import '../styles/global.css';

const latestPosts = (await getCollection('blog', ({ data }) => data.published === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <SEO
      title="404 - Page Not Found"
      description="The page you're looking for doesn't exist."
      canonical={Astro.url.href}
      type="website"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="msapplication-TileColor" content="#ffffff" />

    <!-- Self-hosted Operator Mono font faces -->
    <link rel="stylesheet" href="/fonts/operator-mono.css" />

    <!-- Font Awesome (header and footer icons) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

    <!-- Dark mode initialization script - prevents flash -->
    <script is:inline>
      // Initialize theme before page renders to prevent flash
      (function() {
        const savedTheme = localStorage.getItem('theme');

        // Default to dark mode unless explicitly set to light
        if (savedTheme !== 'light') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google Analytics -->
    <Analytics contentGroup="404" />
    <script is:inline>
      // Report which URL 404'd and where the visitor came from,
      // so broken inbound/internal links surface in GA.
      window.gtag?.('event', 'page_not_found', {
        page_location: window.location.href,
        referrer: document.referrer || '(direct)',
      });
    </script>

    <title>404 - Page Not Found</title>
  </head>
  <body class="flex flex-col min-h-screen font-sans bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200">
    <Header />
    <main class="flex-grow w-full flex items-center justify-center px-4 py-12 sm:py-16" role="main" aria-label="Page not found">
      <div class="w-full max-w-2xl text-center">
        <div class="text-7xl sm:text-8xl mb-6 motion-safe:animate-bounce" aria-hidden="true">🤷‍♂️</div>

        <h1 class="text-6xl sm:text-8xl font-bold mb-4" aria-label="Error 404">
          <span class="text-blue-600 dark:text-blue-400">4</span><span class="text-gray-300 dark:text-gray-700">0</span><span class="text-blue-600 dark:text-blue-400">4</span>
        </h1>

        <p class="text-2xl sm:text-3xl font-light text-gray-600 dark:text-gray-400 mb-3">
          Oops! Nothing here
        </p>
        <p class="text-base text-gray-500 mb-8">
          This page went on vacation 🏖️ The link may be broken, or I moved it.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 mb-14">
          <a
            href="/"
            class="inline-block rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white transition-colors duration-200 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-400"
          >
            ← Take me home
          </a>
          <a
            href="/blog/"
            class="inline-block rounded-lg border border-gray-300 px-5 py-2.5 font-medium text-gray-700 transition-colors duration-200 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800"
          >
            Read the blog
          </a>
          <a
            href="/portfolio/"
            class="inline-block rounded-lg border border-gray-300 px-5 py-2.5 font-medium text-gray-700 transition-colors duration-200 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800"
          >
            See my projects
          </a>
        </div>

        {latestPosts.length > 0 && (
          <section class="text-left" aria-labelledby="latest-posts-heading">
            <h2 id="latest-posts-heading" class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-3">
              While you're here
            </h2>
            <ul class="divide-y divide-gray-200 dark:divide-gray-700 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
              {latestPosts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}/`}
                    class="flex flex-col gap-1 px-4 py-3 transition-colors duration-200 hover:bg-gray-100 dark:hover:bg-gray-700 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
                  >
                    <span class="font-medium text-gray-900 dark:text-gray-100">{post.data.title}</span>
                    <span class="shrink-0 text-sm text-gray-500">{formatDate(post.data.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
