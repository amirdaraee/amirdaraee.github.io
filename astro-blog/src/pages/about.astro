---
import Layout from '../layouts/Layout.astro';

// Structured Data for Person Schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Amirhossein Daraee",
  "alternateName": "Amir Daraee",
  "url": "https://amirdaraee.com",
  "image": "https://amirdaraee.com/amirdaraee.webp",
  "jobTitle": "Full-Stack Web Developer",
  "worksFor": {
    "@type": "Organization",
    "name": "Independent"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Luxembourg",
    "addressCountry": "LU"
  },
  "description": "Full-stack web developer based in Luxembourg with nearly a decade of experience designing and building scalable, reliable web applications. Core expertise in .NET ecosystem and modern front-end frameworks like Angular.",
  "knowsAbout": [".NET", "Angular", "C#", "TypeScript", "Blazor", "Clean Architecture", "Web Development"],
  "sameAs": [
    "https://twitter.com/amirdaraee",
    "https://github.com/amirdaraee"
  ]
};
---

<Layout title="About - Amirdaraee">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-3xl font-bold text-center uppercase text-gray-600 dark:text-gray-400 mb-6">
      About me
    </h2>

    <div class="flex flex-col items-center text-gray-600 dark:text-gray-400 mt-8">
      <h1 class="text-4xl font-semibold mb-8 text-gray-900 dark:text-gray-100">Hello ! I'm Amir</h1>

      <div class="w-full">
        <div class="space-y-6 text-gray-700 dark:text-gray-300 leading-relaxed">
          <picture>
            <source srcset="/amirdaraee.webp" type="image/webp">
            <img
              class="float-left w-44 sm:w-56 h-auto rounded-lg mr-6 mb-2"
              src="/amirdaraee.png"
              alt="Amirhossein Daraee - Full-stack web developer with nearly a decade of experience in .NET and Angular"
            />
          </picture>
          <p>
            I'm Amir, a full-stack web developer based in Luxembourg with nearly a decade of experience designing and building scalable, reliable web applications. My core expertise lies in the .NET ecosystem and modern front-end frameworks like Angular, with a focus on clean architecture, performance, and user-centered design.
          </p>
          <p>
            I'm passionate about creating software that solves meaningful problems while maintaining technical excellence. My experience spans a range of industries and technologies, from enterprise systems to AI-enhanced applications, where I've contributed to architecture design, cloud integration, and continuous delivery. I enjoy learning new tools, improving processes, and finding elegant solutions to complex challenges.
          </p>
          <p>
            Outside of work, I'm an avid reader of fantasy and sci-fi, a lifelong gamer, and someone who enjoys exploring new technologies and ideas. I believe in continuous growth — both personally and professionally — and value balance, curiosity, and creativity in everything I do.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
