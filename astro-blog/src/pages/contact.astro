---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Amirdaraee">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-4xl font-bold text-center mb-8 text-gray-900 dark:text-gray-100">Contact Me</h2>

    <div class="max-w-2xl mx-auto">
      <form name="contact" method="POST" data-netlify-recaptcha="true" data-netlify="true" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="sr-only" for="validationDefault01">Name</label>
            <input
              name="name"
              type="text"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200"
              id="validationDefault01"
              placeholder="Name"
              required
            />
          </div>
          <div>
            <label class="sr-only" for="validationDefault02">Email</label>
            <input
              name="email"
              type="email"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200"
              id="validationDefault02"
              placeholder="Email"
              required
            />
          </div>
          <div>
            <label class="sr-only" for="validationDefault03">Subject</label>
            <input
              name="subject"
              type="text"
              class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200"
              id="validationDefault03"
              value="info"
              placeholder="Subject"
              required
            />
          </div>
        </div>

        <div>
          <label class="sr-only" for="validationDefault04">Message</label>
          <textarea
            name="msg"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors duration-200"
            id="validationDefault04"
            placeholder="Message"
            required
            rows="6"
          ></textarea>
        </div>

        <div class="flex justify-center">
          <div data-netlify-recaptcha="true"></div>
        </div>

        <button
          class="w-full md:w-auto px-8 py-3 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition-colors duration-200"
          type="submit"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</Layout>
