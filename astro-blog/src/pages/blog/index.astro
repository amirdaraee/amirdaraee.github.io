---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.published === true;
});

// Sort by date descending
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog - Amirdaraee">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-center mb-12 text-gray-900">Blog Posts</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <div class="blog-card bg-white rounded-lg shadow-md overflow-hidden flex flex-col h-full transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg">
          {post.data.photo && (
            <img
              src={`/${post.data.photo}`}
              class="w-full h-48 object-cover"
              alt={post.data.title}
            />
          )}
          <div class="p-6 flex flex-col flex-grow">
            <h5 class="text-xl font-semibold mb-3 text-gray-900">{post.data.title}</h5>
            <p class="text-gray-600 mb-4 flex-grow">{post.data.description}</p>
            <div class="mt-auto">
              <small class="text-gray-500 text-sm block mb-2">
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </small>
              <div class="text-right">
                <a
                  href={`/blog/${post.slug}`}
                  class="inline-block px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors duration-200"
                >
                  Read More
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
